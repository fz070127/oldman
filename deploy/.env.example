# PostgreSQL
POSTGRES_DB=silver_bell
POSTGRES_USER=silver_bell
POSTGRES_PASSWORD=

# MinIO（演示环境的后端使用与 MinIO 管理员相同的密钥）
MINIO_ROOT_USER=silver-bell-dev
MINIO_ROOT_PASSWORD=

# 非网页服务的宿主机绑定地址。局域网设备接入时按部署环境调整。
INFRA_BIND_HOST=127.0.0.1
EMQX_DASHBOARD__DEFAULT_PASSWORD=

# FastAPI
APP_ENV=development
# 容器内端口，须与 nginx.conf 的上游端口一致。
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
REDIS_URL=redis://redis:6379/0
JWT_SECRET=
DEMO_SEED_PASSWORD=
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MIN=30
REFRESH_TOKEN_EXPIRE_DAY=7
MINIO_ENDPOINT=minio:9000
MINIO_AK=${MINIO_ROOT_USER}
MINIO_SK=${MINIO_ROOT_PASSWORD}
MINIO_BUCKET=silver-bell
MQTT_HOST=emqx
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
NOTIFY_PROVIDER=mock
ESCALATE_TIME_SCALE=1
ESCALATE_POLL_INTERVAL_SEC=2
CORS_ORIGINS='["http://localhost:8080","http://localhost:8081"]'
